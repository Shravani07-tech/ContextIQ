# ContextIQ — environment variables
#
# Copy to your shell profile or a process manager's env block; every
# variable is optional and falls back to the default shown here
# (defined in config.py). There is no .env auto-loading — set these
# in the real environment of the process.

# Paths (defaults are anchored to the project root)
#CONTEXTIQ_DATA_DIR=./data
#CONTEXTIQ_CHROMA_DIR=./chroma_db

# Vector database
#CONTEXTIQ_COLLECTION=knowledge_base

# Chunking
#CONTEXTIQ_CHUNK_SIZE=1000
#CONTEXTIQ_CHUNK_OVERLAP=200

# Models — changing the embedding model requires re-indexing
#CONTEXTIQ_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#CONTEXTIQ_LLM_MODEL=llama3.2
#OLLAMA_BASE_URL=http://localhost:11434

# Retrieval
#CONTEXTIQ_TOP_K=4

# Upload — server-side per-file size limit in megabytes
#CONTEXTIQ_MAX_UPLOAD_MB=25

# API — comma-separated browser origins allowed by CORS
#CONTEXTIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Feature switches and model-call timeouts (seconds). Timeouts are sized
# for CPU-only inference; lower them on a GPU host.
#CONTEXTIQ_SUMMARY_ENABLED=true
#CONTEXTIQ_SUGGESTED_QUESTIONS_ENABLED=true
#CONTEXTIQ_CITATION_VERIFICATION_ENABLED=true
#CONTEXTIQ_CONTRADICTION_DETECTION_ENABLED=true
#CONTEXTIQ_CITATION_VERIFICATION_TIMEOUT=120
#CONTEXTIQ_CONTRADICTION_TIMEOUT=120

# Timeline extraction (C7)
#CONTEXTIQ_TIMELINE_MAX_DOCUMENTS=10
#CONTEXTIQ_TIMELINE_MAX_CHUNKS=12
#CONTEXTIQ_TIMELINE_MAX_INPUT_CHARS=8000
#CONTEXTIQ_TIMELINE_MAX_EVENTS=40
#CONTEXTIQ_TIMELINE_TIMEOUT=240

# Knowledge graph (C10)
#CONTEXTIQ_GRAPH_MAX_CHUNKS_PER_DOC=8
#CONTEXTIQ_GRAPH_MAX_DOCUMENTS_PER_BUILD=3
#CONTEXTIQ_GRAPH_MAX_INPUT_CHARS=6000
#CONTEXTIQ_GRAPH_MAX_NODES=150
#CONTEXTIQ_GRAPH_TIMEOUT=240

# Bounded deep research (C11) — hard ceilings per run
#CONTEXTIQ_AGENT_MAX_SUBQUESTIONS=4
#CONTEXTIQ_AGENT_MAX_FOLLOWUPS=2
#CONTEXTIQ_AGENT_MAX_RETRIEVALS=8
#CONTEXTIQ_AGENT_TOP_K=4
#CONTEXTIQ_AGENT_MAX_CONTEXT_CHARS=9000
#CONTEXTIQ_AGENT_MAX_ANSWER_TOKENS=900
#CONTEXTIQ_AGENT_TIME_BUDGET=600
#CONTEXTIQ_AGENT_STEP_TIMEOUT=240
