# ContextIQ — Docker Compose environment
#
# Copy to `.env` in this directory (`cp .env.docker.example .env`);
# docker compose auto-loads it. Every value is OPTIONAL — the compose
# file falls back to the same defaults shown here if `.env` is absent.
# There are no secrets: this is a local, single-user deployment.

# ── Host ports (host:container) ──────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000
OLLAMA_PORT=11434

# ── Frontend → backend URL ───────────────────────────────────────────
# Inlined into the client bundle at BUILD time. Because the browser
# calls the API directly, this must be reachable FROM YOUR BROWSER
# (i.e. the host), not the internal http://backend:8000. If you change
# BACKEND_PORT, change the port here too, and rebuild the frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Models ───────────────────────────────────────────────────────────
# Answer-generation model (pulled into Ollama on first `up`).
LLM_MODEL=llama3.2
# Embedding model. NOTE: changing this requires re-indexing — vectors
# from different models are not comparable.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── API behaviour ────────────────────────────────────────────────────
# Browser origins allowed by CORS. Must include the frontend's origin.
CONTEXTIQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per-file upload limit (MB) enforced server-side.
CONTEXTIQ_MAX_UPLOAD_MB=25

# ── Retrieval / chunking ─────────────────────────────────────────────
CONTEXTIQ_TOP_K=5
CONTEXTIQ_CHUNK_SIZE=1000
CONTEXTIQ_CHUNK_OVERLAP=200
