{
  // ContextIQ debug configurations.
  // "Full Stack: ContextIQ" starts both servers with debuggers
  // attached — breakpoints work in Python routes and React
  // components simultaneously.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Frontend: Next.js dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- -p 3000",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: ContextIQ",
      "configurations": ["Backend: FastAPI (uvicorn)", "Frontend: Next.js dev"],
      "stopAll": true
    }
  ]
}
